/build

# misc
.DS_Store
.env
.env.development
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Photos of real receipts must never land in public/ -- everything there is
# copied into build/ and published by `npm run deploy`, where the login gate
# does not apply to static assets.
public/images/*.HEIC
public/images/IMG_*.jpg
public/images/IMG_*.jpeg

# Built by `npm run bundle:mac` (runs on predeploy) from print58.sh + mac/.
public/downloads/
